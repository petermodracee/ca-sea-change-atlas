{#- The county landing page body: a normal document (not a deck), shared by the current route
    (county.njk) and the dated route (county-snapshot.njk). Expects `county` and `dated`. -#}
{#- One topic card's icon: the filled variant when the topic is available, the outlined one when not. -#}
{%- macro topicIcon(ic, filled) -%}
<svg class="cp-card-icon" viewBox="{{ ic.viewBox }}" aria-hidden="true" focusable="false">{{ (ic.fillInner if filled else ic.outlineInner) | safe }}</svg>
{%- endmacro %}
{%- set profile = county.profile %}
{%- set reasons = countyProfiles.reasonsById %}
{%- set base = "/county-profiles/county/" + county.slug + "/" %}

<div class="hero">
<svg class="contours" viewBox="0 0 1180 260" preserveAspectRatio="none" aria-hidden="true">
<path d="M0 220 Q 150 180 300 220 T 600 220 T 900 220 T 1180 220" stroke="#F3EFE0" stroke-width="1.5" fill="none"/>
<path d="M0 240 Q 150 205 300 240 T 600 240 T 900 240 T 1180 240" stroke="#F3EFE0" stroke-width="1.5" fill="none"/>
<path d="M0 260 Q 150 230 300 260 T 600 260 T 900 260 T 1180 260" stroke="#F3EFE0" stroke-width="1.5" fill="none"/>
<path d="M0 200 Q 150 160 300 200 T 600 200 T 900 200 T 1180 200" stroke="#F3EFE0" stroke-width="1.5" fill="none"/>
</svg>
<div class="wrap">
<p class="hero-nav"><a href="{{ '/county-profiles/' | url }}">All county profiles</a>{% if dated %} · <a href="{{ base | url }}">Current profile</a>{% endif %}</p>
<h1>{{ county.name }} County</h1>
{%- if not dated %}{% set switcherTopic = "" %}{% include "county-profiles/county-switcher.njk" %}{% endif %}
{%- if profile %}
<p class="cp-asof"><span class="cp-asof-label">Data as of</span> <time datetime="{{ profile.snapshot }}">{{ profile.snapshot }}</time><span class="cp-asof-meta">Methodology version {{ profile.method }} · generated {{ profile.generated }}</span></p>
{%- else %}
<p class="cp-asof"><span class="cp-asof-label">No data snapshot yet</span><span class="cp-asof-meta">The topics below follow the {{ county.tierLabel | lower }} tier rules.</span></p>
{%- endif %}
</div>
</div>

<div class="main">
<div class="wrap cp">

{%- if dated %}
<p class="cp-note">This is the dated snapshot of {{ profile.snapshot }}. Its canonical address is the <a href="{{ base | url }}">current profile</a>.</p>
{%- if county.correction %}
{%- set fix = county.correction %}
<div class="cp-fixture" role="note">
<p><strong>Correction notice ({{ fix.date }}).</strong> {{ fix.note }} The corrected figures are in the <a href="{{ (base + fix.supersededBy + '/') | url }}">{{ fix.supersededBy }} snapshot</a>. This snapshot is left as published.</p>
</div>
{%- endif %}
{%- elif county.isFixture %}
<div class="cp-fixture" role="note">
<p><strong>Placeholder figures.</strong> This county's topic pages show invented numbers to exercise the layout; they are not measurements of {{ county.name }} County.</p>
</div>
{%- endif %}

<section class="cp-topic" id="topics">
<h2 class="sr-only">Topics</h2>
<div class="cp-topic-cards">
{%- for t in county.coverage %}
{%- set ic = countyProfiles.topicIcons[t.id] %}
{%- if t.hasPage %}
<a class="cp-topic-card is-available" href="{{ (base + (profile.snapshot + '/' if dated else '') + t.slug + '/') | url }}">
{{ topicIcon(ic, true) }}
<h3>{{ t.label }}</h3>
<p class="cp-topic-desc">{{ t.description }}</p>
{%- if t.sectionGaps.length %}
<p class="cp-topic-gaps">{{ t.sectionTotal - t.sectionGaps.length }} of {{ t.sectionTotal }} sections. Not available: {% for g in t.sectionGaps %}{{ g.title }} ({{ g.reasonLabel }}){% if not loop.last %}; {% endif %}{% endfor %}</p>
{%- endif %}
</a>
{%- elif t.available %}
<div class="cp-topic-card is-unavailable">
{{ topicIcon(ic, false) }}
<h3>{{ t.label }}</h3>
<p class="cp-topic-desc">{{ t.description }}</p>
<p class="cp-topic-reason">No data snapshot yet. This topic is available for {{ county.name }} County; its figures have not been built.</p>
</div>
{%- else %}
<div class="cp-topic-card is-unavailable">
{{ topicIcon(ic, false) }}
<h3>{{ t.label }}</h3>
<p class="cp-topic-desc">{{ t.description }}</p>
<p class="cp-topic-reason"><strong>Not available: {{ t.reasonLabel }}.</strong> {{ reasons[t.reason].rule }} <a href="{{ ('/county-profiles/about/data/#reason-' + t.reason) | url }}">About this reason</a></p>
</div>
{%- endif %}
{%- endfor %}
</div>
</section>

<section class="cp-topic cp-chooser-meta" id="earlier-snapshots">
<h2 class="sr-only">Print, download and snapshots</h2>
<p class="cp-actions no-print"><button class="cpd-btn" type="button" onclick="window.print()">Print</button>{% if not dated %} <a href="{{ (base + 'print/') | url }}">Print full profile</a>{% endif %}</p>
{%- if profile %}
<dl class="cp-meta-list">
<dt>Data</dt><dd><a href="{{ ('/data/county-profiles/' + (profile.snapshot if dated else 'latest') + '/' + county.fips + '.json') | url }}">Download this snapshot (JSON)</a></dd>
<dt>Methodology</dt><dd>Version {{ profile.method }} · <a href="{{ '/county-profiles/about/changelog/' | url }}">what changed</a></dd>
<dt>Earlier snapshots</dt>
<dd>
{%- if county.snapshots.length %}
<ul class="cp-snapshot-list">
{%- for s in county.snapshots %}
<li><a href="{{ (base + s.date + '/') | url }}">{{ s.date }}</a>{% if s.isCurrent %} (current){% endif %}{% if dated and s.date == profile.snapshot %} (you are here){% endif %}</li>
{%- endfor %}
</ul>
{%- if county.snapshots.length < 2 %}
<span class="cp-note">A new dated snapshot is added only when this county's figures change, so there is one snapshot until a source revises.</span>
{%- endif %}
{%- else %}
<span class="cp-note">No snapshots yet.</span>
{%- endif %}
</dd>
</dl>
{%- endif %}
</section>

</div>
</div>

{#- The paper version (hidden on screen, shown by @media print): a cover/summary with absolute URLs. -#}
{%- set fullPrint = false %}
{%- set frameLabel = "County profile" %}
{%- set frameCite = site.url ~ ((base + profile.snapshot + "/") | url) %}
<div class="cpp print-only">
{% include "county-profiles/print-frame.njk" %}
<table class="cpp-layout" role="presentation"><thead><tr><td><div class="cpp-sp-h"></div></td></tr></thead><tfoot><tr><td><div class="cpp-sp-f"></div></td></tr></tfoot><tbody><tr><td class="cpp-body">
{% include "county-profiles/print-landing.njk" %}
</td></tr></tbody></table>
</div>

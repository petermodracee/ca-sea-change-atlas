---
permalink: "{{ countyProfileChangelog.feed.path }}"
eleventyExcludeFromCollections: true
---
{#- Atom feed of the generated data changelog: the same entries as site/_includes/county-profiles/data-changelog.njk,
    one per dated snapshot directory. Linked from the changelog page's head (base.njk). -#}
{%- set w = countyProfileChangelog -%}
{%- set entries = countyProfiles.dataChangelog -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
<title>{{ w.feed.title }}</title>
<id>{{ site.url }}{{ w.feed.path }}</id>
<link rel="self" type="application/atom+xml" href="{{ site.url }}{{ w.feed.path }}"/>
<link rel="alternate" type="text/html" href="{{ site.url }}{{ w.feed.page }}"/>
<updated>{{ entries[0].date }}T00:00:00Z</updated>
<author><name>{{ site.name }}</name></author>
{%- for e in entries %}
<entry>
<title>{{ e.date }}: {{ e.label }}, {{ e.countyCount }} {{ w.countyCount.one if e.countyCount == 1 else w.countyCount.many }}</title>
<id>{{ site.url }}{{ w.feed.page }}#data-{{ e.date }}</id>
<link rel="alternate" type="text/html" href="{{ site.url }}{{ w.feed.page }}#data-{{ e.date }}"/>
<updated>{{ e.date }}T00:00:00Z</updated>
{%- set body %}
{%- if e.note %}<p>{{ e.note }}</p>{% endif %}
{%- if e.vintages.length %}<p>{{ w.sourcesHeading }}</p><ul>{% for v in e.vintages %}<li>{{ v }}</li>{% endfor %}</ul>{% endif %}
{%- if e.counties.length %}<p>{{ w.countiesHeading }}</p><ul>{% for c in e.counties %}<li><a href="{{ site.url }}/county-profiles/county/{{ c.slug }}/{{ e.date }}/">{{ c.name }}</a>: {{ c.summary }}{% if c.note %} {{ c.note }}{% endif %}</li>{% endfor %}</ul>{% endif %}
{%- endset %}
<content type="html">{{ body | forceescape }}</content>
</entry>
{%- endfor %}
</feed>

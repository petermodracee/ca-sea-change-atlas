<footer class="site-footer">
<div class="wrap">
<div class="site-footer-links">
<a href="{{ '/index.html' | url }}">{{ site.name }}</a>
<a href="{{ '/about/licenses/' | url }}"{% if nav == "about-licenses" %} aria-current="page"{% endif %}>Licenses</a>
<a href="https://github.com/petermodracee/ca-sea-change-atlas" target="_blank" rel="noopener">GitHub</a>
</div>
{%- if bodyClass == "map-page" %}
{#- Map page is a fixed-viewport app shell: keep the footer to one line and tuck the long copyright/attribution text into a scrollable overlay. #}
<details class="site-footer-details">
<summary>Copyright, data sources &amp; licenses</summary>
<div class="site-footer-details-body">
<p class="site-footer-note">Copyright © 2026 CA Sea Change Atlas. Content licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>, code under <a href="https://www.gnu.org/licenses/gpl-3.0.en.html" target="_blank" rel="noopener">GPLv3</a>, except where noted. Not affiliated with any government or private agency.</p>
{%- if footerAttribution %}
<p class="site-footer-attribution">{{ footerAttribution | safe }}</p>
{%- endif %}
</div>
</details>
{%- else %}
<p class="site-footer-note">Copyright © 2026 CA Sea Change Atlas. Content licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>, code under <a href="https://www.gnu.org/licenses/gpl-3.0.en.html" target="_blank" rel="noopener">GPLv3</a>, except where noted. Not affiliated with any government or private agency.</p>
{%- if footerAttribution %}
<p class="site-footer-attribution">{{ footerAttribution | safe }}</p>
{%- endif %}
{%- endif %}
</div>
</footer>

{#- The one recommended citation. Import with context:
      {% from "county-profiles/citation.njk" import citation, citationUrl with context %}
    citationUrl(county, topic, snapshot) is the absolute dated address to cite; `topic` is the topic
    definition, or null for the county's page. citation(county, topic, snapshot) is the APA text with
    that address as a link (the caller supplies the wrapping element and any label). -#}
{%- macro citationUrl(county, topic, snapshot) -%}
{{ site.url }}{{ ("/county-profiles/county/" + county.slug + "/" + snapshot + "/" + ((topic.slug + "/") if topic else "")) | url }}
{%- endmacro -%}

{%- macro citation(county, topic, snapshot) -%}
{%- set address = citationUrl(county, topic, snapshot) -%}
California Sea Change Atlas. ({{ snapshot | apaDate }}). <em>{{ county.name }} County coastal county profile{% if topic %}: {{ topic.label }}{% endif %}</em>. <a href="{{ address }}">{{ address }}</a>
{%- endmacro -%}

{% include "toc.njk" %}
<div class="about-body" data-toc-source>

<h2 id="project">This project's own licenses</h2>
<p><strong>Code</strong> (Eleventy templates, JavaScript, CSS, build config): <a href="https://www.gnu.org/licenses/gpl-3.0.en.html" target="_blank" rel="noopener">GNU General Public License v3.0</a> — full text in <a href="{{ '/LICENSE' | url }}">LICENSE</a>.</p>
<p><strong>Written content</strong> (page copy, tool comparisons, the <a href="{{ '/about/' | url }}">About page</a> history): <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>. Share and adapt freely, including commercially, with attribution and share-alike.</p>
<p>Neither license covers the third-party material below. Why each source is or isn't on the map is recorded in <a href="https://github.com/petermodracee/ca-sea-change-atlas/blob/main/docs/LICENSING.md" target="_blank" rel="noopener">docs/LICENSING.md</a> on GitHub.</p>

{%- for cat in credits.categories %}

<h2 id="{{ cat.id }}">{{ cat.title }}</h2>
{%- if cat.intro %}
<p>{{ cat.intro }}</p>
{%- endif %}
<ul class="license-list">
{%- for item in cat.items %}
<li>
<div class="license-head"><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.name }}</a></div>
<div class="license-line"><strong>License:</strong>
{%- for key in item.licenses %}{% set lic = licenseTypes[key] %}{% if not loop.first %},{% endif %} <a href="{{ lic.url }}" target="_blank" rel="noopener">{{ lic.name }}</a>{% endfor %}
{%- if item.licenseNote %}{% if item.licenses.length %};{% endif %} {{ item.licenseNote }}{% endif %}
{%- if item.attribution %} &nbsp;·&nbsp; <strong>Credit:</strong> {{ item.attribution }}{% endif %}</div>
{%- if item.note or item.links or item.toolId %}
<div class="license-line">
{%- if item.note %}{{ item.note }}{% endif %}
{%- for link in item.links %} <a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.text }}</a>.{% endfor %}
{%- if item.toolId %} <a href="{{ ('/compare/tool/' + item.toolId + '/') | url }}">About this tool</a>.{% endif %}
</div>
{%- endif %}
{%- if item.studies %}
<ul class="license-studies">
{%- for study in item.studies %}
<li>{{ study }}</li>
{%- endfor %}
</ul>
{%- endif %}
</li>
{%- endfor %}
</ul>
{%- endfor %}

<p>Credits listed here are also shown on the map's own attribution strip. Sources with no credit line are public domain and are listed for transparency.</p>

</div>
</div>

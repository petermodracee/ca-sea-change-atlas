---
layout: base.njk
pagination:
  data: tools
  size: 1
  alias: tool
  addAllPagesToCollections: true
permalink: "tool/{{ tool.id }}/index.html"
nav: sources
eleventyComputed:
  title: "{{ tool.name }} — CA Sea Change Atlas"
  description: "{{ tool.description }}"
---
{%- set schema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": tool.name,
  "description": tool.description,
  "creator": { "@type": "Organization", "name": tool.org },
  "url": tool.url,
  "spatialCoverage": tool.scopeLabel
} %}
<script type="application/ld+json">{{ schema | jsonify | safe }}</script>

<div class="main">
<div class="wrap tool-detail">

<div class="tool-detail-sticky">
<p class="hero-nav"><a href="{{ '/sources.html' | url }}">Back to tool comparison</a></p>

<div class="tool-detail-head">
{%- if tool.implementationStatus == 'implemented' %}
<span class="tag status status-implemented">Implemented in the map tool</span>
{%- elif tool.mapEligibility == 'excluded' %}
<span class="tag status status-excluded">External tool only</span>
{%- else %}
<span class="tag status status-not-implemented">Not implemented in the map tool</span>
{%- endif %}
<h1>{{ tool.name }}</h1>
<div class="org">{{ tool.org }}{% if tool.released %} · released {{ tool.released }}{% endif %}</div>
{%- if tool.url %}
<a class="landing-card-cta" href="{{ tool.url }}" target="_blank" rel="noopener">Visit {{ tool.name }}</a>
{%- endif %}
</div>
</div>


{%- set sections = tool | toolSections(toolDetailSchema, toolTagMasters) %}
<div class="tool-detail-layout">
<nav class="tool-detail-toc" aria-label="On this page">
<h2>On this page</h2>
<ul>{% if tool.keyFeatures and tool.keyFeatures.length %}<li><a href="#key-features">Key features</a></li>{% endif %}{% if tool.screenshots and tool.screenshots.length %}<li><a href="#screenshots">Screenshots</a></li>{% endif %}{% for section in sections %}<li><a href="#{{ section.id }}">{{ section.title }}</a></li>{% endfor %}</ul>
</nav>
<div class="tool-detail-grid">
<p class="tool-detail-lede">{{ tool.description }}</p>
{%- if tool.keyFeatures and tool.keyFeatures.length %}
<section class="tool-detail-section" id="key-features">
<h2>Key features</h2>
<ul class="tool-key-features">{% for f in tool.keyFeatures %}<li>{{ f }}</li>{% endfor %}</ul>
</section>
{%- endif %}
{%- if tool.screenshots and tool.screenshots.length %}
<section class="tool-detail-section" id="screenshots">
<h2>Screenshots</h2>
<div class="tool-screenshots">
{%- for shot in tool.screenshots %}
<figure>
<a href="{{ shot.src | url }}" target="_blank" rel="noopener" title="Open full-size image"><img src="{{ shot.src | url }}" alt="{{ shot.alt }}" loading="lazy" decoding="async"></a>
<figcaption>{{ shot.caption }}<span class="tool-screenshot-credit">Screenshot: {{ shot.credit }}{% if shot.copyright %} · {{ shot.copyright }}{% endif %} · captured {{ shot.capturedOn }}</span></figcaption>
</figure>
{%- endfor %}
</div>
</section>
{%- endif %}
{%- for section in sections %}
<section class="tool-detail-section" id="{{ section.id }}">
<h2>{{ section.title }}</h2>
<dl class="tool-detail-rows">
{%- if section.tags %}
{%- for t in section.tags %}
<div class="tool-detail-row">
<dt>{{ t.label }}</dt>
<dd>{% if t.yes %}<strong>Yes</strong>{% if t.detail %} — {{ t.detail }}{% endif %}{% else %}No{% endif %}</dd>
</div>
{%- endfor %}
{%- else %}
{%- for row in section.rows %}
<div class="tool-detail-row">
<dt>{{ row.label }}</dt>
<dd>
{%- if row.kind == "list" %}<ul>{% for item in row.items %}<li>{{ item }}</li>{% endfor %}</ul>
{%- elif row.kind == "link" %}<a href="{{ row.href }}" target="_blank" rel="noopener">{{ row.href }}</a>
{%- else %}{{ row.text }}{% endif -%}
</dd>
</div>
{%- endfor %}
{%- endif %}
</dl>
</section>
{%- endfor %}
</div>
</div>
</div>
</div>
<script>
// Offset the sticky contents box and anchor targets by the sticky header's height.
(function () {
  var head = document.querySelector(".tool-detail-sticky");
  var root = document.querySelector(".tool-detail");
  if (!head || !root || !window.ResizeObserver) return;
  new ResizeObserver(function () {
    root.style.setProperty("--tool-sticky-h", head.offsetHeight + "px");
  }).observe(head);
})();
</script>
